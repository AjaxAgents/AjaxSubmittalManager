# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Where projects, libraries, jobs and outputs are stored (git-ignored)
ASM_DATA_DIR=./data
# Set to 1 to run the whole pipeline with a deterministic offline stand-in for Claude
# (no API key needed; for demos and tests - findings are heuristic, not a real review)
ASM_MOCK_LLM=0
# Optional overrides
# ASM_JOB_USD_CAP=15
# ASM_PORT=8765
